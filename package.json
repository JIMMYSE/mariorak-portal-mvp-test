    "@tanstack/eslint-plugin-query": "^5.20.1",
    "@types/crypto-js": "^4.2.2",
    "@types/josa": "^3.0.5",
    "@types/node": "^20.11.24",
    "@types/sanitize-html": "^2.11.0",
    "@typescript-eslint/eslint-plugin": "^7.2.0",

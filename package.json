{
  "name": "meta-airforce-portal",
  "version": "0.0.1",
  "description": "Meta Airforce Portal Front",
  "productName": "Meta Airforce Portal Front",
  "author": "COARSOFT",
  "private": true,
  "scripts": {
    "dev": "cross-env ENV=localhost quasar dev",
    "dev2": "yarn dto && dev",
    "build:dev": "ENV=development npx quasar build",
    "build:stg": "ENV=staging npx quasar build",
    "build:prd": "ENV=production npx quasar build",
    "deploy": "npx quasar build && aws s3 sync ./dist/spa s3://coar-template-bucket --profile default",
    "lint": "eslint --ext .js,.ts,.vue ./",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dto": "yarn cache clean && yarn add 'github:coarsoft-tmp/seoroverse-dto#release'"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.11",
    "@tanstack/vue-query": "^5.35.2",
    "@tanstack/vue-query-devtools": "^5.35.2",
    "@vee-validate/rules": "^4.12.6",
    "@vee-validate/yup": "^4.12.6",
    "@vueuse/core": "^10.9.0",
    "@vueuse/integrations": "^10.9.0",
    "axios": "^1.6.8",
    "clsx": "^2.1.0",
    "cross-env": "^7.0.3",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.11",
    "dotenv": "^16.4.4",
    "josa": "^3.0.1",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "quasar": "^2.16.1",
    "radix-vue": "^1.4.9",
    "sanitize-html": "^2.13.0",
    "seoroverse-dto": "github:coarsoft-tmp/seoroverse-dto#release",
    "swiper": "^11.1.1",
    "tailwind-merge": "^2.2.2",
    "universal-cookie": "^7.1.4",
    "vee-validate": "^4.12.6",
    "vue": "^3.4.27",
    "vue-i18n": "^9.13.1",
    "vue-router": "^4.3.2",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@intlify/vite-plugin-vue-i18n": "^7.0.0",
    "@quasar/app-vite": "^1.9.2",
    "@tanstack/eslint-plugin-query": "^5.32.1",
    "@types/crypto-js": "^4.2.2",
    "@types/josa": "^3.0.5",
    "@types/node": "^20.12.7",
    "@types/sanitize-html": "^2.11.0",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-vue": "^9.25.0",
    "postcss": "^8.4.38",
    "prettier": "^2.8.8",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "unplugin-auto-import": "^0.17.6",
    "unplugin-vue-components": "^0.27.0"
  },
  "engines": {
    "node": "^20 || ^18 || ^16",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}

    "@vee-validate/yup": "^4.12.5",
    "@vueuse/core": "^10.9.0",
    "@vueuse/integrations": "^10.9.0",
    "axios": "^1.6.7",
    "clsx": "^2.1.0",
    "cross-env": "^7.0.3",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.4",
    "josa": "^3.0.1",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "quasar": "^2.15.1",
    "radix-vue": "^1.4.9",
    "remixicon": "^4.1.0",
    "sanitize-html": "^2.12.0",
    "swiper": "^11.0.7",

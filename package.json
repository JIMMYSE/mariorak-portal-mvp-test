{
  "name": "ccf-portal",
  "version": "1.0.6",
  "description": "CCF ㅣ 팬과 함께 만들어가는 게임 개발 커뮤니티",
  "productName": "CCF ㅣ 팬과 함께 만들어가는 게임 개발 커뮤니티",
  "author": "COARSOFT",
  "private": true,
  "scripts": {
    "dev": "cross-env ENV=localhost quasar dev --host",
    "dev2": "yarn dto && cross-env ENV=development quasar dev",
    "build:dev": "ENV=development npx quasar build",
    "build:stg": "ENV=staging npx quasar build",
    "build:prd": "ENV=production npx quasar build",
    "deploy": "npx quasar build && aws s3 sync ./dist/spa s3://coar-template-bucket --profile default",
    "lint": "eslint --ext .js,.ts,.vue ./",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dto:dev": "rm -rf ./node_modules/meta-airforce-dto && npm install 'github:coarsoft-tmp/meta-airforce-dto#develop' --no-save && rm -rf ./node_modules/ccf-api-dto && npm install 'github:coarsoft-tmp/ccf-api-dto#develop' --no-save",
    "dto:prd": "rm -rf ./node_modules/meta-airforce-dto && npm install 'github:coarsoft-tmp/meta-airforce-dto#develop' --no-save && rm -rf ./node_modules/ccf-api-dto && npm install 'github:coarsoft-tmp/ccf-api-dto#main' --no-save",
    "dto": "yarn cache clean && yarn add 'github:coarsoft-tmp/meta-airforce-dto' && yarn add 'github:coarsoft-tmp/ccf-api-dto#develop'",
    "set-version": "coar-devtools set-version -f ./public/app.json"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.11",
    "@tanstack/vue-query": "^5.41.0",
    "@tanstack/vue-query-devtools": "^5.41.0",
    "@tiptap/extension-character-count": "^2.4.0",
    "@tiptap/extension-color": "^2.4.0",
    "@tiptap/extension-highlight": "^2.4.0",
    "@tiptap/extension-image": "^2.4.0",
    "@tiptap/extension-placeholder": "^2.4.0",
    "@tiptap/extension-text-align": "^2.4.0",
    "@tiptap/extension-text-style": "^2.4.0",
    "@tiptap/extension-underline": "^2.4.0",
    "@tiptap/pm": "^2.4.0",
    "@tiptap/starter-kit": "^2.4.0",
    "@tiptap/vue-3": "^2.4.0",
    "@vee-validate/rules": "^4.13.1",
    "@vee-validate/yup": "^4.13.1",
    "@vueuse/core": "^10.10.0",
    "@vueuse/integrations": "^10.10.0",
    "@vueuse/router": "^11.0.3",
    "axios": "^1.6.8",
    "ccf-api-dto": "github:coarsoft-tmp/ccf-api-dto#develop",
    "clsx": "^2.1.0",
    "cross-env": "^7.0.3",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.11",
    "dotenv": "^16.4.4",
    "josa": "^3.0.1",
    "meta-airforce-dto": "github:coarsoft-tmp/meta-airforce-dto#develop",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "pretendard": "^1.3.9",
    "quasar": "^2.16.4",
    "radix-vue": "^1.4.9",
    "sanitize-html": "^2.13.0",
    "swiper": "^11.1.1",
    "tailwind-merge": "^2.2.2",
    "universal-cookie": "^7.1.4",
    "vee-validate": "^4.12.6",
    "vue": "^3.4.27",
    "vue-i18n": "^9.13.1",
    "vue-router": "^4.3.3",
    "vue3-carousel": "^0.3.3",
    "vue3-google-login": "^2.0.33",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@intlify/vite-plugin-vue-i18n": "^7.0.0",
    "@quasar/app-vite": "^1.9.3",
    "@tanstack/eslint-plugin-query": "^5.43.1",
    "@types/crypto-js": "^4.2.2",
    "@types/josa": "^3.0.5",
    "@types/lodash": "^4.17.7",
    "@types/node": "^20.14.2",
    "@types/sanitize-html": "^2.11.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "autoprefixer": "^10.4.19",
    "coar-node-devtools": "github:coarsoft-tmp/coar-node-devtools#semver:1.0.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-vue": "^9.25.0",
    "postcss": "^8.4.38",
    "prettier": "^2.8.8",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "unplugin-auto-import": "^0.17.6",
    "unplugin-vue-components": "^0.27.0"
  },
  "engines": {
    "node": "^20",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
